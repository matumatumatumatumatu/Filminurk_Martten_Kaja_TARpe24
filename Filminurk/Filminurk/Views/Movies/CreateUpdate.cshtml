@using Filminurk.Models.Movies
@model Filminurk.Models.Movies.MoviesCreateUpdateViewModel

@if (Model.ID.HasValue)
{
    <h1>Muuda film</h1>
}
else
{
    <h1>Lisa film</h1>
}

<div>
    <form asp-action="@(Model.ID.HasValue ? "Update" : "Create")" method="post">

        <input asp-for="ID" type="hidden" />
        <input asp-for="EntryCreatedAt" type="hidden" />
        <input asp-for="EntryModifiedAt" type="hidden" />

        <div class="form-group row">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" />
        </div>

        <div class="form-group row">
            <label asp-for="CurrentRating"></label>
            <input asp-for="CurrentRating" class="form-control" />
        </div>

        <div class="form-group row">
            <label asp-for="Description"></label>
            <input asp-for="Description" class="form-control" />
        </div>

        <div class="form-group row">
            <label asp-for="FirstPublished"></label>
            <input asp-for="FirstPublished" class="form-control" />
        </div>

        <div class="form-group row">
            <label asp-for="Director"></label>
            <input asp-for="Director" class="form-control" />
        </div>

        <div class="form-group row">
            <label asp-for="RottenTomatoes"></label>
            <input asp-for="RottenTomatoes" class="form-control" />
        </div>

        <div class="form-group row">
            <label asp-for="OscarsWon"></label>
            <input asp-for="OscarsWon" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            @(Model.ID.HasValue ? "Update" : "Create")
        </button>

        <a asp-action="Index" class="btn btn-success">Back</a>

    </form>
</div>