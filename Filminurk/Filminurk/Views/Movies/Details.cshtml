@model Filminurk.Models.Movies.MoviesDetailsViewModel

<h1>Filmi info</h1>

<div>
    <h4>Filmi info</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.ID</dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">Pealkiri</dt>
        <dd class="col-sm-10">@Model.Title</dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">Kirjeldus</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">Väljalaskeaeg</dt>
        <dd class="col-sm-10">@Model.FirstPublished</dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">Režissöör</dt>
        <dd class="col-sm-10">@Model.Director</dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">Näitlejad</dt>
        <dd class="col-sm-10">@Model.Actors</dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">Hinnang</dt>
        <dd class="col-sm-10">@Model.CurrentRating</dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">Rotten Tomatoes</dt>
        <dd class="col-sm-10">@Model.RottenTomatoes</dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">Lisatud</dt>
        <dd class="col-sm-10">@Model.EntryCreatedAt</dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">Muudetud</dt>
        <dd class="col-sm-10">@Model.EntryModifiedAt</dd>
    </dl>

    <dl>
        @foreach (var image in Model.Images)
        {
            <partial name="_Images" model="image" />
        }
    </dl>

    <hr />

    <a asp-action="Index" asp-controller="Movies" class="btn btn-danger">Tagasi</a>
</div>