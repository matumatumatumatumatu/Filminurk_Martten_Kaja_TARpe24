@model Filminurk.Models.Actors.ActorsDeleteViewModel

<h1>Kustuta Näitleja</h1>

<div>
    <h4>Näitleja</h4>
    <hr />
    <dl class="row">
        <div class="form-group-row">
            <label asp-for="FirstName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.FirstName)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group-row">
            <label asp-for="LastName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.LastName)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group-row">
            <label asp-for="Age" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Age)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group-row">
            <label asp-for="Nationality" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Nationality)
        </div>
    </dl>

    <hr />
    <form asp-action="DeleteConfirmation">
        <input type="hidden" asp-for="ActorID" />
        <input type="submit" value="Eemalda" class="btn btn-danger" />
        <a asp-action="Index" asp-controller="Actors" class="btn btn-success">Tagasi</a>
    </form>
</div>