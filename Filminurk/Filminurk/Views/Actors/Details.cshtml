@model Filminurk.Models.Actors.ActorsCreateUpdateViewModel

<h1>Näitleja info</h1>

<div>
    <h4>Näitleja</h4>
    <hr />

    <dl class="row">
        <div class="form-group row">
            <label asp-for="FirstName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.FirstName)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="LastName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.LastName)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="NickName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.NickName)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="Age" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Age)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="Nationality" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Nationality)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="IsActive" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.IsActive)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="PortraitID" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.PortraitID)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="EntryCreatedAt" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.EntryCreatedAt)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="EntryModifiedAt" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.EntryModifiedAt)
        </div>
    </dl>

    <hr />
    <a asp-action="Index" asp-controller="Actors" class="btn btn-danger">Tagasi</a>
</div>