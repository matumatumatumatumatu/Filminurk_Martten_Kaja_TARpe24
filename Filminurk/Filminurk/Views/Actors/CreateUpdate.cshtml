@using Filminurk.Models.Actors
@model Filminurk.Models.Actors.ActorsCreateUpdateViewModel

@if (Model.ActorID != Guid.Empty)
{
    <h1>Muuda Näitleja</h1>
}
else
{
    <h1>Lisa Näitleja</h1>
}

<div>
    <form method="post" enctype="multipart/form-data">
        <input asp-for="ActorID" type="hidden" />
        <input asp-for="EntryCreatedAt" type="hidden" />
        <input asp-for="EntryModifiedAt" type="hidden" />

        <div class="form-group row">
            <label asp-for="FirstName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="FirstName" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="LastName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="LastName" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="NickName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="NickName" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Age" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Age" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Nationality" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <select asp-for="Nationality" asp-items="Html.GetEnumSelectList<Nationality>()">
                    <option value="">-- Vali Rahvus --</option>
                </select>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="IsActive" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="IsActive" type="checkbox" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="PortraitID" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="PortraitID" class="form-control" />
            </div>
        </div>

        @if (Model.ActorID != Guid.Empty)
        {
            <input asp-action="Update" asp-controller="Actors" type="submit" class="btn btn-primary" value="Uuenda" />
        }
        else
        {
            <input asp-action="Create" asp-controller="Actors" type="submit" class="btn btn-primary" value="Lisa" />
        }
        <a asp-action="Index" asp-controller="Actors" class="btn btn-success">Tagasi</a>

    </form>
</div>